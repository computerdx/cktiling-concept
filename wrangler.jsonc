{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sitescout-cktiling-concept",
  "main": "worker.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "cktiling.computerdx.com",
      "custom_domain": true
    }
  ]
}
